# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Server-only secret. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: enables the Messenger web "Send" dialog on desktop.
# Without it, the Messenger button uses the mobile app link (fb-messenger://).
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Resend: emailing a bouquet link to the recipient (https://resend.com)
# Server-only secrets. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=re_your_key_here
# Must be an address on a domain verified in Resend.
EMAIL_FROM="Davey's Daisies <hello@yourdomain.com>"
# Public address of the site, used to build links inside emails (no trailing slash).
SITE_URL=http://localhost:3000
# Long random string that signs Report/Block links and hashes blocked addresses.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Don't change it after launch, or old Report/Block links stop working.
EMAIL_LINK_SECRET=
